```gitignore
# Build artifacts
build/
dist/

# Dependencies
node_modules/
venv/
.venv/
__pycache__/
*.egg-info/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Environment
.env
.env.local
*.env.*

# Logs and temp files
*.log
*.tmp
*.bak

# OS files
.DS_Store
Thumbs.db

# Coverage reports
coverage/
htmlcov/
*.coverage

# Compiled files
*.pyc
*.class
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.out

# Package manager caches
.npm/
.yarn/
.pip/
.mypy_cache/
.pytest_cache/
.gradle/
target/
```